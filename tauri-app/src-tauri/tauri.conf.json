{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Account Hub",
  "version": "0.5.28",
  "identifier": "com.workbuddy.accounthub",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node dev-server.mjs",
    "beforeBuildCommand": "echo noop"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy 账户中枢",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
